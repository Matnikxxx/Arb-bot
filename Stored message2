package login;

// This class is used to store message data in JSON format
// It is required for saving messages to a file using Gson

public class StoredMessage {

    private String messageId;
    private String recipient;
    private String message;
    private String status;

    // Constructor
    public StoredMessage(String messageId, String recipient, String message, String status) {
        this.messageId = messageId;
        this.recipient = recipient;
        this.message = message;
        this.status = status;
    }

    // Getters (required for Gson)

    public String getMessageId() {
        return messageId;
    }

    public String getRecipient() {
        return recipient;
    }

    public String getMessage() {
        return message;
    }

    public String getStatus() {
        return status;
    }

    @Override
    public String toString() {
        return messageId + " | " + recipient + " | " + message + " | " + status;
    }
}
